# Copier en .env et choisir des secrets locaux (ne jamais commiter .env).
MYSQL_ROOT_PASSWORD=remplacer_par_un_secret_local
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
POSTGRES_DB=safebase_demo
POSTGRES_USER=safebase
POSTGRES_PASSWORD=remplacer_par_un_autre_secret_local
# Bases existantes à sauvegarder chaque jour à 12 h UTC.
BACKUP_DATABASE=atelier_theoa
PG_BACKUP_DATABASE=safebase_demo
